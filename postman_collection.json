{
  "info": {
    "_postman_id": "f7b29a61-83d4-4aa6-9b5f-73a6ad6d31e2",
    "name": "Task Management REST API",
    "description": "Postman collection for every implemented public, authentication, and task-management API. Register and log in as either the user or admin actor; both roles can use the task endpoints, which are scoped to the authenticated account.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Public_APIs",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/",
            "description": "Checks that the API server is online."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Morgan\",\n  \"email\": \"alex.morgan@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"role\": \"user\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Creates a standard user account. The registration endpoint accepts the user role."
          }
        },
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Taylor Reed\",\n  \"email\": \"taylor.reed@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Creates an admin account using the role value accepted by the registration validator."
          }
        },
        {
          "name": "Login User (saves token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"token\", pm.response.json().items?.token || pm.response.json().data?.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex.morgan@example.com\",\n  \"password\": \"SecurePass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Logs in the user actor. Run Register User first if this account is not already present. Saves the JWT to the Postman environment variable token."
          }
        },
        {
          "name": "Login Admin (saves token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"token\", pm.response.json().items?.token || pm.response.json().data?.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"taylor.reed@example.com\",\n  \"password\": \"SecurePass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Logs in the admin actor. Run Register Admin first if this account is not already present. Saves the JWT to the Postman environment variable token."
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me",
            "description": "Returns the profile for the account represented by the current Bearer token."
          }
        }
      ]
    },
    {
      "name": "Task_Management (User and Admin)",
      "item": [
        {
          "name": "Create Task (saves taskId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "const taskId = response.data?.id || response.items?.id;",
                  "if (taskId) pm.environment.set(\"taskId\", taskId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Prepare project delivery plan\",\n  \"description\": \"Finalize milestones, owners, and review dates for the next release.\",\n  \"priority\": \"high\",\n  \"status\": \"pending\",\n  \"dueDate\": \"2026-11-15T17:00:00.000Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/tasks",
            "description": "Creates a task owned by the authenticated user and stores its ID as the taskId environment variable."
          }
        },
        {
          "name": "List Tasks (pagination, filters, search, sort)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks?page=1&limit=10&status=pending&priority=high&search=project&sortBy=dueDate&order=asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "pending"
                },
                {
                  "key": "priority",
                  "value": "high"
                },
                {
                  "key": "search",
                  "value": "project"
                },
                {
                  "key": "sortBy",
                  "value": "dueDate"
                },
                {
                  "key": "order",
                  "value": "asc"
                }
              ]
            },
            "description": "Lists only tasks owned by the authenticated account. Supported filters include status, priority, and search; sorting supports createdAt, dueDate, priority, or title."
          }
        },
        {
          "name": "Get Task By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}",
            "description": "Gets a task owned by the authenticated account. Run Create Task first to populate taskId."
          }
        },
        {
          "name": "Update Task (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Deliver reviewed project plan\",\n  \"description\": \"Publish the reviewed release plan with owners and milestone dates.\",\n  \"priority\": \"urgent\",\n  \"status\": \"in-progress\",\n  \"dueDate\": \"2026-11-18T17:00:00.000Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/tasks/{{taskId}}",
            "description": "Updates all allowed task fields. Requires a taskId created by the currently authenticated account."
          }
        },
        {
          "name": "Partially Update Task (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\",\n  \"priority\": \"medium\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/tasks/{{taskId}}",
            "description": "Updates only the supplied allowed task fields. Requires a taskId created by the currently authenticated account."
          }
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}",
            "description": "Deletes a task owned by the authenticated account."
          }
        }
      ]
    }
  ]
}
