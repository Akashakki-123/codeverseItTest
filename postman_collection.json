{
  "info": {
    "_postman_id": "7b89f5a0-9c1d-4861-a87b-task-management-api",
    "name": "Task Management & User Auth REST API",
    "description": "Production-grade REST API Postman Collection.\nFeatures complete User & Auth CRUD, Task CRUD with Ownership Filtering, Joi Validation, Pagination, and Error Handling.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "task_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication & User Operations",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"johndoe@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"role\": \"user\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new user."
          }
        },
        {
          "name": "Login User (Auto-saves JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data.token) {",
                  "    pm.collectionVariables.set('jwt_token', response.data.token);",
                  "    console.log('JWT Token successfully saved: ' + response.data.token);",
                  "}",
                  "if (response.data && response.data.user) {",
                  "    pm.collectionVariables.set('user_id', response.data.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"johndoe@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates user and returns JWT token."
          }
        },
        {
          "name": "Get Profile (/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Returns authenticated user profile."
          }
        },
        {
          "name": "Update Profile (/me)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Updated\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Updates authenticated user profile."
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"SecurePass123!\",\n  \"newPassword\": \"BrandNewPassword456!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/change-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "change-password"]
            },
            "description": "Changes user password after bcrypt validation."
          }
        },
        {
          "name": "Get All Users (Pagination & Filters)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/users?page=1&limit=10&role=user&sortBy=createdAt&order=desc",
              "host": ["{{base_url}}"],
              "path": ["auth", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "role", "value": "user", "disabled": true },
                { "key": "search", "value": "John", "disabled": true },
                { "key": "sortBy", "value": "createdAt" },
                { "key": "order", "value": "desc" }
              ]
            },
            "description": "Retrieves all users list with pagination, role filtering, and search."
          }
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["auth", "users", "{{user_id}}"]
            },
            "description": "Gets specific user details by ID."
          }
        },
        {
          "name": "Update User By ID",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Super\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["auth", "users", "{{user_id}}"]
            },
            "description": "Updates user by ID."
          }
        },
        {
          "name": "Delete User By ID",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["auth", "users", "{{user_id}}"]
            },
            "description": "Deletes user and cascades deletion of user tasks."
          }
        }
      ]
    },
    {
      "name": "2. Tasks Management",
      "item": [
        {
          "name": "Create Task (Auto-saves Task ID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "const taskId = response.data?.id || response.data?._id;",
                  "if (taskId) {",
                  "    pm.collectionVariables.set('task_id', taskId);",
                  "    console.log('Task ID saved: ' + taskId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Complete Machine Test Assignment\",\n  \"description\": \"Build production-grade Task REST API with Node.js and Express\",\n  \"priority\": \"high\",\n  \"status\": \"pending\",\n  \"dueDate\": \"2026-11-05T12:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/tasks",
              "host": ["{{base_url}}"],
              "path": ["tasks"]
            },
            "description": "Creates task associated with authenticated user identity."
          }
        },
        {
          "name": "List Tasks (Filtered & Paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tasks?page=1&limit=10&status=pending&sortBy=createdAt&order=desc",
              "host": ["{{base_url}}"],
              "path": ["tasks"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "pending" },
                { "key": "priority", "value": "high", "disabled": true },
                { "key": "search", "value": "Assignment", "disabled": true },
                { "key": "sortBy", "value": "createdAt" },
                { "key": "order", "value": "desc" }
              ]
            },
            "description": "Returns list of tasks belonging strictly to the authenticated user."
          }
        },
        {
          "name": "Get Task By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["tasks", "{{task_id}}"]
            },
            "description": "Retrieves task by ID. Returns 404 if the task belongs to another user."
          }
        },
        {
          "name": "Update Task (PATCH / PUT)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in-progress\",\n  \"priority\": \"urgent\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["tasks", "{{task_id}}"]
            },
            "description": "Updates allowed task fields."
          }
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["tasks", "{{task_id}}"]
            },
            "description": "Deletes user-owned task."
          }
        }
      ]
    },
    {
      "name": "3. Error & Validation Edge Cases",
      "item": [
        {
          "name": "Invalid ObjectId Handling (Returns 400)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tasks/invalid-object-id-123",
              "host": ["{{base_url}}"],
              "path": ["tasks", "invalid-object-id-123"]
            },
            "description": "Validates ObjectId format and returns clean 400 response."
          }
        },
        {
          "name": "Unauthorized Access (No Token - Returns 401)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/tasks",
              "host": ["{{base_url}}"],
              "path": ["tasks"]
            },
            "description": "Verifies that accessing protected endpoints without Bearer token returns 401."
          }
        }
      ]
    }
  ]
}
